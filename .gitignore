# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data pipeline raw cache (large, re-downloadable)
/data/raw/

# alert pipeline working files (snapshots, review queue)
/data/watch/

# community database (personal data — never commit)
/data/community.db*

# generated before each build (scripts/build-public.ts)
/public/manifest.webmanifest
/public/programme-status.json
/public/fx.json
